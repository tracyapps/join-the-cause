<?xml version="1.0"?>
<ruleset name="Join the Cause">
	<description>Coding standards for the Join the Cause plugin (WordPress standard, text domain join-the-cause).</description>

	<file>.</file>

	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/assets/css/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="join-the-cause"/></property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.3"/>
	<config name="testVersion" value="8.0-"/>
</ruleset>
